<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account move cron -->
    <record id="account_move_cron" model="ir.cron">
        <field name="name">HU+ Account Move</field>
        <field name="code">model.l10n_hu_run_account_move_cron()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
    </record>
    <!-- Object API cron (inactive: object API path is incomplete / unused) -->
    <record id="object_api_cron" model="ir.cron">
        <field name="name">HU+ Object API</field>
        <field name="active" eval="False"/>
        <field name="code">model.run_object_api_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="l10n_hu_plus.model_l10n_hu_plus_object"/>
        <field name="state">code</field>
    </record>
</odoo>
