<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view inherit -->
    <record id="view_company_form_inherit" model="ir.ui.view">
        <field name="name">l10n.hu.plus.view.company.form.inherit</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="model">res.company</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <!-- Fields -->
            <xpath expr="//page[last()]" position="after">
                <page name="l10n_hu_plus" string="HU+">
                    <group name="l10n_hu_plus">
                        <group name="l10n_hu_plus_1">

                        </group>
                        <group name="l10n_hu_plus_2">
                            <div name="l10n_hu_plus_actions" colspan="2">
                                <button name="action_l10n_hu_plus_view_documentation" class="btn-secondary btn-sm m-2" icon="fa-info-circle" string="Documentation" type="object"/>
                                <button name="action_l10n_hu_plus_apply_configuration" class="btn-secondary btn-sm m-2" groups="l10n_hu_plus.manager_group" icon="fa-magic" string="Configuration" type="object"/>
                                <button name="action_l10n_hu_plus_view_technical_data" class="btn-link btn-sm m-2" groups="base.group_no_one" icon="fa-code" string="View technical data" type="object"/>
                            </div>
                        </group>
                    </group>
                    <group name="l10n_hu_plus_api" string="HU+ API">
                        <group name="l10n_hu_plus_api_1">
                            <field name="l10n_hu_plus_api_enabled" string="API Enabled" widget="boolean_toggle"/>
                            <field name="l10n_hu_plus_api_registered" string="API Registered"/>
                            <field name="l10n_hu_plus_api_timestamp" string="API Timestamp"/>
                            <field name="l10n_hu_plus_api_license_valid" string="API License Valid"/>
                        </group>
                        <group name="l10n_hu_plus_api_2">
                            <div name="l10n_hu_plus_api_actions" colspan="2">
                                <button name="action_l10n_hu_plus_api_create_registration" class="btn-secondary btn-sm m-2" groups="l10n_hu_plus.manager_group" icon="fa-magic" invisible="l10n_hu_plus_api_registered" string="Create API registration" type="object"/>
                                <button name="action_l10n_hu_plus_api_get_objects" class="btn-secondary btn-sm m-2" groups="l10n_hu_plus.manager_group" icon="fa-download" invisible="not l10n_hu_plus_api_registered" string="Download API objects" type="object"/>
                                <button name="action_l10n_hu_plus_api_check_registration" class="btn-secondary btn-sm m-2" groups="l10n_hu_plus.manager_group" icon="fa-magic" invisible="not l10n_hu_plus_api_registered" string="Check API registration" type="object"/>
                                <button name="action_l10n_hu_plus_api_delete_registration" class="btn-warning btn-sm m-2 text-white" groups="l10n_hu_plus.manager_group" icon="fa-trash" invisible="not l10n_hu_plus_api_registered" string="Delete API registration" type="object"/>
                                <button name="action_l10n_hu_plus_api_reset_registration" class="btn-danger btn-sm m-2 text-white " groups="l10n_hu_plus.manager_group" icon="fa-eraser" string="Reset API registration" type="object"/>
                                <button name="action_l10n_hu_plus_api_list_logs" class="btn-link btn-sm m-2" groups="base.group_no_one" icon="fa-history" string="View API logs" type="object"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
        