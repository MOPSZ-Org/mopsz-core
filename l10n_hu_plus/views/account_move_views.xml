<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view inherit -->
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">l10n.hu.plus.view.move.form.inherit</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <!-- HU+ banner -->
            <xpath expr="//div[1]" position="before">
                <div name="l10n_hu_plus_banner" class="border font-weight-bold mb-2 p-1" invisible="not l10n_hu_plus_enabled or not l10n_hu_banner_enabled">
                    <div name="l10n_hu_banner_start" class="d-inline ms-2">
                        <span name="hu_flag">
                            <img src="/l10n_hu_plus/static/description/hu_flag.png" alt="HU Flag" class="p-0" width="36px"/>
                        </span>
                        <span name="action_l10n_hu_plus_documentation">
                            <button name="action_l10n_hu_plus_view_documentation" class="btn-link" string="HU+" type="object"/>
                        </span>
                    </div>
                    <div name="l10n_hu_banner_center" class="d-inline">
                        <span name="l10n_hu_proforma_set" class="ms-2 me-2" invisible="not l10n_hu_proforma_date or not l10n_hu_proforma_name">
                            <field name="l10n_hu_proforma_name" readonly="1" string="Proforma"/>
                        </span>
                        <span name="l10n_hu_proforma_not_set" class="ms-2 me-2" invisible="l10n_hu_proforma_date and l10n_hu_proforma_name">
                            <field name="l10n_hu_proforma_name" class="text-danger" readonly="1" string="Proforma"/>
                        </span>
                        <span name="l10n_hu_plus_tag" class="ms-2 me-2" groups="l10n_hu_plus.user_group">
                            <field name="l10n_hu_plus_tag" context="{'default_tag_type': 'account_move'}" domain="[('company', '=', company_id), ('tag_type', 'in', ['account_move', 'general'])]" nolabel="1" options="{'color_field': 'color'}" placeholder="Tags..." widget="many2many_tags"/>
                        </span>
                        <span name="l10n_hu_plus_notes" class="ms-2 me-2" groups="l10n_hu_plus.user_group">
                            <field name="l10n_hu_plus_notes" nolabel="1" placeholder="Notes..." style="min-width:200px;"/>
                        </span>
                    </div>
                    <div name="l10n_hu_banner_end" class="d-inline float-end">
                        <span name="l10n_hu_update_fields" class="ms-2" groups="l10n_hu_plus.user_group" invisible="state != 'draft'">
                            <button name="action_l10n_hu_update_fields" class="btn-primary" data-hotkey="d" icon="fa-bolt" title="Update fields" type="object"/>
                        </span>
                        <span name="l10n_hu_uncheck" class="ms-2" groups="l10n_hu_plus.user_group" invisible="state != 'posted' or not checked">
                            <button name="action_l10n_hu_uncheck" class="btn-secondary text-success" data-hotkey="d" icon="fa-check-square-o" title="Set to not checked" type="object"/>
                        </span>
                        <span name="l10n_hu_hu_wizard_accounting" class="ms-2" groups="l10n_hu_plus.user_group" invisible="state != 'draft'">
                            <button name="action_l10n_hu_wizard_accounting" class="btn-secondary" data-hotkey="f" icon="fa-book" title="Accounting" type="object"/>
                        </span>
                        <span name="l10n_hu_plus_status_error" class="ms-2" groups="l10n_hu_plus.user_group" invisible="l10n_hu_plus_status != 'error'">
                            <button name="action_l10n_hu_wizard_check_status" class="btn-danger" data-hotkey="e" icon="fa-heartbeat" title="Check status" type="object"/>
                        </span>
                        <span name="l10n_hu_plus_status_info" class="ms-2" groups="l10n_hu_plus.user_group" invisible="l10n_hu_plus_status not in [False, 'other']">
                            <button name="action_l10n_hu_wizard_check_status" class="btn-info" data-hotkey="e" icon="fa-heartbeat" title="Check status" type="object"/>
                        </span>
                        <span name="l10n_hu_plus_status_success" class="ms-2" groups="l10n_hu_plus.user_group" invisible="l10n_hu_plus_status not in ['closed', 'ok']">
                            <button name="action_l10n_hu_wizard_check_status" class="btn-success" data-hotkey="e" icon="fa-heartbeat" title="Check status" type="object"/>
                        </span>
                        <span name="l10n_hu_plus_status_warning" class="ms-2" groups="l10n_hu_plus.user_group" invisible="l10n_hu_plus_status != 'warning'">
                            <button name="action_l10n_hu_wizard_check_status" class="btn-warning text-white" data-hotkey="e" icon="fa-heartbeat" title="Check status" type="object"/>
                        </span>
                        <div name="l10n_hu_banner_dropdown" class="btn-group ms-2">
                            <a id="l10nHuDropdownMenuLink" name="l10n_hu_banner_dropdown_button" class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Actions
                            </a>
                            <ul name="l10n_hu_banner_dropdown_items" aria-labelledby="l10nHuDropdownMenuLink" class="dropdown-menu dropdown-menu-end" role="menu">
                                <li name="l10n_hu_send_proforma" invisible="state != 'draft' or not l10n_hu_proforma_sequence">
                                    <button name="action_l10n_hu_send_proforma" class="dropdown-item" icon="fa-send" string="Proforma Send" type="object"/>
                                </li>
                                <li name="l10n_hu_send_proforma_divider" class="dropdown-divider" invisible="state != 'draft' or not l10n_hu_proforma_sequence"/>
                                <li name="l10n_hu_view_currency_rates" groups="l10n_hu_plus.user_group" invisible="currency_id == company_currency_id">
                                    <button name="action_l10n_hu_view_currency_rates" class="dropdown-item" icon="fa-area-chart" string="Currency Rates" type="object"/>
                                </li>
                                <li name="l10n_hu_currency_divider" class="dropdown-divider" groups="l10n_hu_plus.user_group" invisible="currency_id == company_currency_id"/>
                                <li name="l10n_hu_view_account_move_lines" groups="account.group_account_readonly">
                                    <button name="action_l10n_hu_view_account_move_lines" class="dropdown-item" icon="fa-list" string="Account Move Line" type="object"/>
                                </li>
                                <li name="l10n_hu_account_move_line_divider" class="dropdown-divider" groups="account.group_account_readonly"/>
                                <li name="l10n_hu_view_analytic_lines" groups="analytic.group_analytic_accounting">
                                    <button name="action_l10n_hu_view_analytic_lines" class="dropdown-item" icon="fa-list" string="Analytic Line" type="object"/>
                                </li>
                                <li name="l10n_hu_analytic_divider" class="dropdown-divider" groups="analytic.group_analytic_accounting"/>
                                <li name="l10n_hu_plus_documentation">
                                    <button name="action_l10n_hu_plus_view_documentation" class="dropdown-item" icon="fa-info-circle" string="Documentation" type="object"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </xpath>
            <!-- HU+ invoice currency rate inverse -->
            <xpath expr="//div[@name='currency_conversion_div']" position="after">
                <div name="l10n_hu_invoice_currency_rate_inverse_div" class="d-flex gap-1 text-muted" invisible="currency_id == company_currency_id or l10n_hu_company_currency_name != 'HUF'">
                    <span>1</span>
                    <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="l10n_hu_invoice_currency_rate_inverse" digits="[12,2]" readonly="state != 'draft'"/>
                    <field name="company_currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                </div>
            </xpath>
            <!-- HU+ fields -->
            <xpath expr="//page[@name='aml_tab']" position="after">
                <page name="l10n_hu_plus" invisible="not l10n_hu_plus_enabled" string="HU+">
                    <group name="l10n_hu_plus">
                        <group name="l10n_hu_plus_1" invisible="l10n_hu_journal_type not in ['purchase', 'sale']">
                            <!-- Document type-->
                            <field name="l10n_hu_document_type" domain="[('company', '=', company_id), ('tag_type', '=', 'document_type')]" options="{'no_create': True,}" placeholder="Document type..." readonly="state != 'draft' and checked" string="Document Type"/>
                            <field name="l10n_hu_document_type_code" invisible="1"/>
                            <field name="l10n_hu_document_type_technical_name" invisible="1"/>
                            <!-- Document HUF -->
                            <label name="l10n_hu_document_huf_label" for="l10n_hu_document_vat_huf" string="Document HUF"/>
                            <div name="l10n_hu_document_huf_div">
                                <div name="l10n_hu_document_huf_div_1" class="d-flex gap-1 justify-content-start">
                                    <field name="l10n_hu_document_net_huf" class="text-muted w-auto"/>
                                    <span class="text-muted w-auto">+</span>
                                    <field name="l10n_hu_document_vat_huf" class="w-auto" readonly="state != 'draft' and checked"/>
                                    <span class="text-muted w-auto">=</span>
                                    <field name="l10n_hu_document_gross_huf" class="text-muted w-auto"/>
                                </div>
                                <div name="l10n_hu_document_huf_div_2" class="d-flex gap-1 justify-content-start">
                                    <field name="l10n_hu_document_rate" class="text-muted w-auto" digits="[12,2]"/>
                                    <field name="l10n_hu_huf_currency" class="text-muted w-auto" options="{'no_open': True}" readonly="True"/>
                                    <span class="text-muted w-auto">/</span>
                                    <field name="currency_id" class="text-muted w-auto" options="{'no_open': True}" readonly="True"/>
                                </div>
                            </div>
                            <!-- Currency -->
                            <field name="l10n_hu_company_currency_name" invisible="1"/>
                            <field name="l10n_hu_huf_rate" invisible="l10n_hu_company_currency_name == 'HUF'" readonly="state != 'draft'"/>
                            <div name="l10n_hu_currency_actions" colspan="2" invisible="l10n_hu_banner_enabled or (l10n_hu_company_currency_name == 'HUF' and l10n_hu_currency_name == 'HUF')">
                                <button name="action_l10n_hu_view_currency_rates" class="btn-secondary m-1" groups="l10n_hu_plus.user_group" icon="fa-area-chart" string="Currency Rates" type="object"/>
                            </div>
                            <!-- Original invoice -->
                            <label name="l10n_hu_original_invoice" for="l10n_hu_original_invoice_number" invisible="l10n_hu_document_type_technical_name in ['invoice_normal']" string="Original Invoice Number"/>
                            <div name="l10n_hu_original_invoice" invisible="l10n_hu_document_type_technical_name in ['invoice_normal']">
                                <field name="reversed_entry_id" invisible="not reversed_entry_id"/>
                                <field name="l10n_hu_original_invoice_number" class="oe_inline" invisible="reversed_entry_id" readonly="state != 'draft' and checked"/>
                                <button name="action_l10n_hu_view_original_invoice" class="oe_inline btn-sm btn-link" icon="fa-folder-open" invisible="reversed_entry_id or not l10n_hu_original_invoice_number" string="View" type="object"/>
                            </div>
                            <!-- Delivery period -->
                            <label name="l10n_hu_delivery_period_label" for="l10n_hu_delivery_period_start" string="Delivery Period"/>
                            <div name="l10n_hu_delivery_period_div" class="d-flex d-row gap-1 justify-content-start">
                                <field name="l10n_hu_delivery_period_start" class="text-end w-25" placeholder="Start date..." readonly="state != 'draft' and checked"/>
                                <span class="text-muted w-auto">-</span>
                                <field name="l10n_hu_delivery_period_end" class="text-start w-25" placeholder="End date..." readonly="state != 'draft' and checked"/>
                            </div>
                            <!-- Proforma -->
                            <label name="l10n_hu_proforma_label" for="l10n_hu_proforma_name" invisible="l10n_hu_journal_type == 'sale' and not l10n_hu_proforma_sequence" string="Proforma"/>
                            <div name="l10n_hu_proforma_div" class="d-flex d-row gap-1 justify-content-start" invisible="l10n_hu_journal_type == 'sale' and not l10n_hu_proforma_sequence">
                                <field name="l10n_hu_proforma_name" class="w-auto" placeholder="Proforma name..." readonly="state != 'draft' and checked"/>
                                <field name="l10n_hu_proforma_date" class="w-auto" placeholder="Proforma date..." readonly="state != 'draft' and checked"/>
                                <div name="l10n_hu_proforma_actions" invisible="l10n_hu_journal_type != 'sale' or not l10n_hu_proforma_sequence or l10n_hu_banner_enabled">
                                    <button name="action_l10n_hu_send_proforma" class="btn-secondary m-1" groups="l10n_hu_plus.user_group" icon="fa-send" invisible="state != 'draft' or not l10n_hu_proforma_sequence" string="Proforma Send" type="object"/>
                                </div>
                            </div>
                            <!-- HU+ Tags -->
                            <field name="l10n_hu_plus_tag" context="{'default_tag_type': 'account_move'}" domain="[('company', '=', company_id), ('tag_type', 'in', ['account_move', 'general'])]" groups="l10n_hu_plus.user_group" invisible="l10n_hu_banner_enabled" options="{'color_field': 'color'}" string="Tags" widget="many2many_tags"/>
                            <!-- HU+ Notes -->
                            <field name="l10n_hu_plus_notes" groups="l10n_hu_plus.user_group" invisible="l10n_hu_banner_enabled" string="Notes"/>
                            <!-- HU+ Status -->
                            <field name="l10n_hu_plus_status" invisible="l10n_hu_banner_enabled" readonly="state != 'draft' and checked" string="HU+ Status"/>
                            <!-- Accounting -->
                            <div name="l10n_hu_accounting_actions" colspan="2" groups="account.group_account_readonly" invisible="l10n_hu_banner_enabled">
                                <button name="action_l10n_hu_view_account_move_lines" class="btn-secondary m-1" icon="fa-list" string="Account Move Line" type="object"/>
                            </div>
                            <!-- Analytic -->
                            <div name="l10n_hu_analytic_actions" colspan="2" groups="analytic.group_analytic_accounting" invisible="l10n_hu_banner_enabled">
                                <button name="action_l10n_hu_view_analytic_lines" class="btn-secondary m-1" icon="fa-list" string="Analytic Line" type="object"/>
                            </div>
                        </group>
                        <group name="l10n_hu_plus_2" invisible="l10n_hu_journal_type not in ['purchase', 'sale']">
                            <!-- VAT -->
                            <field name="l10n_hu_vat_status" readonly="state != 'draft' and checked" string="VAT Status"/>
                            <field name="l10n_hu_vat_date" readonly="state != 'draft' and checked" string="VAT Date"/>
                            <field name="l10n_hu_cash_accounting" force_save="1" readonly="state != 'draft' and checked" string="Cash Accounting"/>
                        </group>
                        <!-- Partner -->
                        <group name="l10n_hu_plus_partner" invisible="l10n_hu_journal_type not in ['purchase', 'sale']" string="Partner">
                            <field name="l10n_hu_fiscal_representative" invisible="l10n_hu_journal_type not in ['purchase', 'sale']" options="{'no_create': True,}" readonly="state != 'draft' and checked" string="Fiscal Representative"/>
                            <field name="l10n_hu_fiscal_representative_bank_account" domain="[('partner_id', '=', l10n_hu_fiscal_representative)]" invisible="l10n_hu_journal_type not in ['purchase', 'sale']" options="{'no_create': True,}" readonly="state != 'draft' and checked" string="Fiscal Representative Bank Account"/>
                            <field name="l10n_hu_company_partner" string="Company Partner"/>
                            <field name="l10n_hu_partner_country" string="Partner Country"/>
                        </group>
                        <!-- Journal -->
                        <group name="l10n_hu_plus_journal" groups="l10n_hu_plus.manager_group" string="Journal">
                            <field name="l10n_hu_plus_enabled" string="HU+"/>
                            <field name="l10n_hu_banner_enabled" string="Banner"/>
                            <field name="l10n_hu_proforma_sequence" invisible="not l10n_hu_proforma_sequence" string="Proforma Sequence"/>
                            <field name="l10n_hu_journal_type" string="Journal Type"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- List view inherit  -->
    <record id="view_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">l10n.hu.plus.view.invoice.tree.inherit</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <!-- Add proforma -->
            <field name="name" position="after">
                <field name="l10n_hu_proforma_name" optional="hide" readonly="state in ['cancel', 'posted']" string="Proforma Name"/>
            </field>
            <!-- Trade position -->
            <xpath expr="//field[@name='date']" position="before">
                <field name="l10n_hu_partner_country" optional="hide"/>
                <field name="l10n_hu_trade_position" optional="hide" string="Trade Position"/>
            </xpath>
            <!-- Delivery date and VAT -->
            <field name="date" position="after">
                <field name="delivery_date" optional="hide" readonly="state in ['cancel', 'posted']" string="Delivery Date"/>
                <field name="l10n_hu_vat_date" optional="hide" string="VAT Date"/>
                <field name="l10n_hu_vat_status" optional="hide" string="VAT Status"/>
            </field>
            <!-- HU+ workflow -->
            <xpath expr="//field[@name='checked']" position="before">
                <field name="l10n_hu_plus_tag" optional="hide" options="{'color_field': 'color'}" string="HU+ Tag" widget="many2many_tags"/>
                <field name="l10n_hu_plus_notes" optional="hide" string="HU+ Notes"/>
                <field name="l10n_hu_plus_status" optional="hide" string="HU+ Status"/>
            </xpath>
        </field>
    </record>
    <!-- List view HU+  -->
    <record id="invoice_view_list" model="ir.ui.view">
        <field name="name">l10n.hu.plus.invoice.view.list</field>
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <list string="Invoices" js_class="account_tree" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" expand="context.get('expand', False)" multi_edit="1" sample="1">
                <field name="name" decoration-bf="1" decoration-danger="made_sequence_gap and state == 'posted'" widget="char_with_placeholder_field" placeholder="/"/>
                <field name="l10n_hu_document_type" optional="hide" readonly="state in ['cancel', 'posted']" string="Document Type"/>
                <field name="ref" optional="show"/>
                <field name="invoice_origin" optional="hide" string="Source Document"/>
                <field name="l10n_hu_proforma_name" optional="hide" readonly="state in ['cancel', 'posted']" string="Proforma Name"/>
                <field name="invoice_partner_display_name" column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'in_receipt')" groups="base.group_user" string="Vendor"/>
                <field name="invoice_partner_display_name" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')" groups="base.group_user" string="Customer"/>
                <field name="l10n_hu_partner_country" optional="hide"/>
                <field name="l10n_hu_trade_position" optional="hide" string="Trade Position"/>
                <!-- Dates -->
                <field name="invoice_date" optional="show" column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'in_receipt')" readonly="state != 'draft'" string="Bill Date" decoration-warning="abnormal_date_warning"/>
                <field name="invoice_date" optional="show" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')" readonly="state != 'draft'" string="Invoice Date" decoration-warning="abnormal_date_warning"/>
                <field name="date" optional="hide" string="Accounting Date" readonly="state in ['cancel', 'posted']"/>
                <field name="l10n_hu_delivery_period_start" optional="hide" readonly="state in ['cancel', 'posted']" string="Delivery Start"/>
                <field name="l10n_hu_delivery_period_end" optional="hide" readonly="state in ['cancel', 'posted']" string="Delivery End"/>
                <field name="delivery_date" optional="show" readonly="state in ['cancel', 'posted']" string="Delivery Date"/>
                <!-- VAT -->
                <field name="l10n_hu_cash_accounting" optional="hide" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')"/>
                <field name="l10n_hu_vat_date" optional="show" string="VAT Date"/>
                <field name="l10n_hu_vat_status" decoration-info="l10n_hu_vat_status == 'to_declare'" decoration-muted="l10n_hu_vat_status in ('excluded', 'legacy', 'out_of_scope')" decoration-success="l10n_hu_vat_status == 'declared'" decoration-warning="l10n_hu_vat_status == 'postponed'" optional="show" string="VAT Status"/>
                <!-- Amounts -->
                <field name="currency_id" optional="hide" readonly="state in ['cancel', 'posted']" string="Currency"/>
                <field name="amount_untaxed" optional="show" string="Net" sum="Net Total"/>
                <field name="amount_tax" optional="show" string="Tax" sum="Tax Total"/>
                <field name="amount_total" decoration-bf="1" optional="show" string="Total" sum="Total"/>
                <field name="amount_total_in_currency_signed" decoration-bf="1" decoration-warning="abnormal_amount_warning" groups="base.group_multi_currency" optional="hide" string="Signed Total" sum="Signed Total"/>
                <field name="amount_untaxed_signed" optional="hide" string="Accounting Net" sum="Accounting Net Total"/>
                <field name="amount_tax_signed" optional="show" string="Accounting Tax" sum="Accounting Tax Total"/>
                <field name="amount_total_signed" optional="hide" string="Accounting Total" sum="Accounting Total"/>
                <!-- Payment -->
                <field name="status_in_payment" decoration-info="state == 'draft'" decoration-danger="payment_state == 'not_paid' and invoice_date_due &lt; context_today().strftime('%Y-%m-%d')" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" invisible="payment_state == 'invoicing_legacy' or move_type == 'entry'" optional="show" string="Payment Status" widget="badge"/>
                <field name="invoice_date_due" invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'" optional="hide" widget="remaining_days" />
                <field name="amount_residual_signed" optional="hide" string="Amount Due" sum="Amount Due Total"/>
                <!-- Workflow -->
                <field name="checked" optional="show" widget="boolean_toggle"/>
                <field name="state" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" decoration-success="state == 'posted'" optional="hide" string="Accounting Status"  widget="badge"/>
                <field name="l10n_hu_edi_state" decoration-success="l10n_hu_edi_state == 'confirmed'" decoration-warning="l10n_hu_edi_state != 'confirmed'" optional="hide" string="EDI Status"  widget="badge"/>
                <field name="invoice_user_id" optional="hide" string="User" widget="many2one_avatar_user"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="l10n_hu_plus_tag" optional="show" options="{'color_field': 'color'}" string="HU+ Tag" widget="many2many_tags"/>
                <field name="l10n_hu_plus_notes" optional="show" string="HU+ Notes"/>
                <field name="l10n_hu_plus_status" optional="hide" string="HU+ Status"/>
                <field name="move_sent_values" string="Sent" widget="badge" decoration-success="move_sent_values == 'sent'" decoration-danger="move_sent_values == 'not_sent'" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')" optional="hide"/>
                <!-- Parent -->
                <field name="journal_id" optional="hide" string="Journal"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
                <field name="company_id" groups="!base.group_multi_company" column_invisible="True"/>
                <!-- Invisible -->
                <field name="made_sequence_gap" column_invisible="True"/>
                <field name="duplicated_ref_ids" column_invisible="True"/> <!-- Needed for customer view account_tree-->
                <field name="move_type" column_invisible="context.get('default_move_type', True)"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="abnormal_amount_warning" column_invisible="1"/>
                <field name="abnormal_date_warning" column_invisible="1"/>
              </list>
        </field>
    </record>
    <!-- Pivot view HU+  -->
    <record id="invoice_view_pivot" model="ir.ui.view">
        <field name="name">l10n.hu.plus.invoice.view.pivot</field>
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <pivot string="Account Move" sample="1">
                <field name="move_type" type="row"/>
                <field name="delivery_date" interval="year" type="col"/>
            </pivot>
        </field>
    </record>
    <!-- Search view inherit  -->
    <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
        <field name="name">l10n.hu.plus.view.account.invoice.filter.inherit</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="model">account.move</field>
        <field name="priority">36</field>
        <field name="arch" type="xml">
            <!-- Field -->
            <xpath expr="//field[@name='name'][1]" position="attributes">
                <attribute name="filter_domain">['|', '|' , '|', '|', '|',
                    ('name', 'ilike', self), ('invoice_origin', 'ilike', self),
                    ('ref', 'ilike', self), ('payment_reference', 'ilike', self),
                    ('partner_id', 'child_of', self),('l10n_hu_proforma_name', 'ilike', self)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="l10n_hu_proforma_name" string="Proforma"/>
                <field name="l10n_hu_plus_tag" string="HU+ Tag"/>
                <field name="l10n_hu_plus_notes" string="HU+ Notes"/>
                <field name="l10n_hu_vat_status" string="VAT Status"/>
            </xpath>
            <!-- Filter -->
            <xpath expr="//filter[@name='invoice_date']" position="after">
                <filter name="delivery_date_filter" date="delivery_date" string="Delivery Date"/>
            </xpath>
            <xpath expr="//filter[@name='due_date']" position="after">
                <separator/>
                <filter name="l10n_hu_vat_date_filter" date="l10n_hu_vat_date" string="VAT Date"/>
                <filter name="l10n_hu_proforma_date_filter" date="l10n_hu_proforma_date" string="Proforma Date"/>
                <separator/>
                <filter name="l10n_hu_proforma_sent_filter" domain="[('l10n_hu_proforma_date', '!=', False), ('l10n_hu_proforma_name', '!=', False)]" string="Proforma Sent"/>
                <filter name="l10n_hu_cash_accounting_filter" domain="[('l10n_hu_cash_accounting', '=', True)]" string="Cash Accounting"/>
                <filter name="l10n_hu_delivery_period_filter" domain="['|', ('l10n_hu_delivery_period_start', '!=', False), ('l10n_hu_delivery_period_end', '!=', False)]" string="Delivery Period"/>
                <separator/>
                <filter name="l10n_hu_plus_tag_filter" domain="[('l10n_hu_plus_tag', '!=', False)]" string="HU+ Tags"/>
                <filter name="l10n_hu_plus_notes_filter" domain="[('l10n_hu_plus_notes', '!=', False)]" string="HU+ Notes"/>
                <separator/>
                <filter name="l10n_hu_trade_position_domestic_filter" domain="[('l10n_hu_trade_position', '=', 'domestic')]" string="Domestic"/>
                <filter name="l10n_hu_trade_position_eu_filter" domain="[('l10n_hu_trade_position', '=', 'eu')]" string="EU"/>
                <filter name="l10n_hu_trade_position_other_filter" domain="[('l10n_hu_trade_position', '=', 'other')]" string="Other"/>
                <filter name="l10n_hu_trade_position_none_filter" domain="[('l10n_hu_trade_position', '=', False)]" string="No Trade Position"/>
            </xpath>
            <!-- Filter group by -->
            <xpath expr="//filter[@name='invoicedate']" position="after">
                <filter name="delivery_date_filter_group_by" context="{'group_by': 'delivery_date'}" string="Delivery Date"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_sequence_prefix']" position="after">
                <separator/>
                <filter name="l10n_hu_plus_tag_filter_group_by" context="{'group_by': 'l10n_hu_plus_tag'}" string="HU+ Tag"/>
                <filter name="l10n_hu_plus_status_filter_group_by" context="{'group_by': 'l10n_hu_plus_status'}" string="HU+ Status"/>
                <filter name="l10n_hu_edi_state_filter_group_by" context="{'group_by': 'l10n_hu_edi_state'}" string="EDI Status"/>
                <filter name="l10n_hu_document_type_filter_group_by" context="{'group_by': 'l10n_hu_document_type'}" string="Document Type"/>
                <filter name="l10n_hu_vat_date_filter_group_by" context="{'group_by': 'l10n_hu_vat_date'}" string="VAT Date"/>
                <filter name="l10n_hu_vat_status_filter_group_by" context="{'group_by': 'l10n_hu_vat_status'}" string="VAT Status"/>
                <filter name="l10n_hu_cash_accounting_group_by" context="{'group_by': 'l10n_hu_cash_accounting'}" string="Cash Accounting"/>
                <filter name="l10n_hu_proforma_date_filter_group_by" context="{'group_by': 'l10n_hu_proforma_date'}" string="Proforma Date"/>
                <filter name="l10n_hu_partner_country_filter_group_by" context="{'group_by': 'l10n_hu_partner_country'}" string="Partner Country"/>
                <filter name="l10n_hu_trade_position_filter_group_by" context="{'group_by': 'l10n_hu_trade_position'}" string="Trade Position"/>
                <filter name="commercial_partner_id_filter_group_by" context="{'group_by': 'commercial_partner_id'}" string="Commercial Partner"/>
            </xpath>
        </field>
    </record>
</odoo>
