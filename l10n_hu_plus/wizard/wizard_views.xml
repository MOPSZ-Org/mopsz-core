<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.hu.plus.wizard.view.form</field>
        <field name="model">l10n.hu.plus.wizard</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form>
                <!-- BASE -->
                <group name="base">
                    <!-- FIELDS -->
                    <group name="fields">
                        <!-- TECHNICAL -->
                        <field name="active_model" force_save="1" invisible="1" options="{'no_open': True,}" readonly="1"/>
                        <field name="active_model_id" force_save="1" invisible="1"/>
                        <field name="active_model_name" invisible="1"/>
                        <field name="company" force_save="1" invisible="1"/>
                        <field name="company_currency" force_save="1" invisible="1"/>
                        <field name="huf_currency" force_save="1" invisible="1"/>
                        <!-- ACTION TYPES -->
                        <field name="action_type_editable" invisible="1"/>
                        <field name="action_type_visible" invisible="1"/>
                        <field name="action_type" force_save="1" invisible="not action_type_visible" readonly="not action_type_editable" required="1"/>
                        <!-- ACCOUNT MOVE -->
                        <field name="account_move_action_editable" invisible="1"/>
                        <field name="account_move_action_visible" invisible="1"/>
                        <field name="account_move_action" force_save="1" invisible="action_type != 'account_move' or not account_move_action_visible" readonly="not account_move_action_editable" string="Action"/>
                        <field name="accounting_journal" invisible="1" options="{'no_create': True}" string="Journal"/>
                        <field name="accounting_move_currency" invisible="1"/>
                        <field name="accounting_move_type" invisible="1"/>
                        <!-- ACCOUNT MOVE HU+ STATUS -->
                        <label name="account_move_hu_plus_status_label" for="accounting_hu_plus_status" invisible="account_move_action not in ['check_status', 'update_fields']" string="HU+ Status"/>
                        <div name="account_move_hu_plus_status_div" invisible="account_move_action not in ['check_status', 'update_fields']">
                            <field name="accounting_hu_plus_status" placeholder="Select..."/>
                            <field name="accounting_hu_plus_tag" colspan="2" context="{'default_tag_type': 'account_move'}" domain="[('company', '=', company), ('tag_type', 'in', ['account_move', 'general'])]" options="{'color_field': 'color'}" placeholder="Tags..." widget="many2many_tags"/>
                            <field name="accounting_hu_plus_notes" colspan="2" placeholder="Notes..."/>
                        </div>
                        <!-- API -->
                        <field name="api_action_editable" invisible="1"/>
                        <field name="api_action" force_save="1" invisible="action_type != 'api'" readonly="not api_action_editable" required="action_type == 'api'" string="Action"/>
                        <field name="api_license_code" invisible="api_action not in ['check_registration', 'create_registration', 'delete_registration']" readonly="api_action in ['check_registration', 'delete_registration']" required="api_action in ['check_registration', 'create_registration', 'delete_registration']" string="License Code"/>
                        <field name="api_key" invisible="api_action not in ['check_registration', 'create_registration', 'delete_registration']" readonly="api_action in ['check_registration', 'delete_registration']" required="api_action in ['check_registration', 'create_registration', 'delete_registration']" string="API Key"/>
                        <field name="api_url" groups="l10n_hu_plus.manager_group" invisible="api_action not in ['check_registration', 'create_registration', 'delete_registration']" readonly="api_action in ['check_registration', 'delete_registration']" required="api_action in ['check_registration', 'create_registration', 'delete_registration']" string="API URL"/>
                        <!-- CONFIGURATION -->
                        <field name="configuration_audit_trail" invisible="action_type != 'configuration'" string="Audit Trail"/>
                        <field name="configuration_document_types" invisible="action_type != 'configuration'" string="Document Types"/>
                        <field name="configuration_enabled_journals" invisible="action_type != 'configuration'" options="{'no_create': True}" string="Enabled Journals" widget="many2many_tags"/>
                        <!-- PARTNER -->
                        <field name="partner_action_editable" invisible="1"/>
                        <field name="partner_action" force_save="1" invisible="action_type != 'partner'" readonly="not partner_action_editable" required="action_type == 'partner'" string="Action"/>
                        <!-- TECHNICAL -->
                        <field name="technical_action_editable" invisible="1"/>
                        <field name="technical_action" force_save="1" invisible="action_type != 'technical'" readonly="not technical_action_editable" required="action_type == 'technical'" string="Action"/>
                    </group>
                    <!-- CARDS -->
                    <group name="cards">
                        <!-- CARD - ACCOUNT MOVE -->
                        <div name="account_ move_info" class="card border-info" colspan="2" invisible="action_type != 'account_move'">
                            <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                            <div class="card-body">
                                <p class="card-text" invisible="account_move_action">Please select an action</p>
                                <p class="card-text" invisible="account_move_action != 'check_status'">Check HU+ status of the account move</p>
                                <p class="card-text" invisible="account_move_action != 'update_fields'">Update account move fields</p>
                            </div>
                        </div>
                        <!-- CARD - API -->
                        <div name="api_info" class="card border-info" colspan="2" invisible="action_type != 'api'">
                            <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                            <div class="card-body">
                                <p class="card-text" invisible="api_action != 'check_registration'">Check API registration</p>
                                <p class="card-text" invisible="api_action != 'create_registration'">Create API registration</p>
                                <p class="card-text" invisible="api_action != 'delete_registration'">Delete API registration</p>
                                <p class="card-text" invisible="api_action == 'download_objects' or api_details in [False, '']"><field name="api_details"/></p>
                                <p class="card-text" invisible="api_action != 'download_objects'">Download API objects</p>
                                <p class="card-text" invisible="api_action != 'view_api_data'">View API data</p>
                            </div>
                        </div>
                        <!-- CARD - CONFIGURATION -->
                        <div name="configuration_info" class="card border-info" colspan="2" invisible="action_type != 'configuration'">
                            <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                            <div class="card-body">
                                <p class="card-text">Apply HU+ configuration</p>
                                <p class="card-text">Check the documentation for details</p>
                            </div>
                        </div>
                        <!-- CARD - PARTNER -->
                        <div name="partner_info" class="card border-info" colspan="2" invisible="action_type != 'partner'">
                            <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                            <div class="card-body">
                                <p class="card-text" invisible="partner_action != False">Manage partners</p>
                                <p class="card-text" invisible="partner_action != 'list'">List partners</p>
                            </div>
                        </div>
                        <!-- CARD - TECHNICAL -->
                        <div name="technical_info" class="card border-info" colspan="2" invisible="action_type != 'technical'">
                            <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                            <div class="card-body">
                                <p class="card-text" invisible="technical_action != False">Manage technical actions</p>
                                <p class="card-text" invisible="technical_action != 'view_data'">View data in JSON format</p>
                            </div>
                        </div>
                    </group>
                </group>
                <!-- TEXT -->
                <group name="info_text" invisible="info_text in [False, '']">
                    <div name="info_text" class="card border-info" colspan="2">
                        <div class="card-header bg-info text-white"><i class="fa fa-info-circle me-1"/>Information</div>
                        <div class="card-body">
                            <field name="info_text" style="word-break: break-word;"/>
                        </div>
                    </div>
                </group>
                <group name="error_text" invisible="error_text in [False, '']">
                    <div name="error_text" class="card border-danger" colspan="2">
                        <div class="card-header bg-danger text-white"><i class="fa fa-exclamation-circle me-1"/>Error</div>
                        <div class="card-body">
                            <field name="error_text" style="word-break: break-word;"/>
                        </div>
                    </div>
                </group>
                <group name="warning_text" invisible="warning_text in [False, '']">
                    <div name="warning_text" class="card border-warning" colspan="2">
                        <div class="card-header bg-warning text-white"><i class="fa fa-info-exclamation-triangle me-1"/>Warning</div>
                        <div class="card-body">
                            <field name="warning_text" style="word-break: break-word;"/>
                        </div>
                    </div>
                </group>
                <group name="success_text" invisible="success_text in [False, '']">
                    <div name="warning_text" class="card border-success" colspan="2">
                        <div class="card-header bg-success text-white"><i class="fa fa-check me-1"/>Success</div>
                        <div class="card-body">
                            <field name="success_text" style="word-break: break-word;"/>
                        </div>
                    </div>
                </group>
                <!-- ADDITIONAL FIELDS -->
                <group name="accounting_fields" invisible="action_type != 'account_move' or account_move_action != 'update_fields'">
                    <group name="accounting_fields_1">
                        <!-- Document type-->
                        <field name="accounting_document_type" options="{'no_create': True, 'no_open': True}" string="Document Type"/>
                        <!-- Document VAT HUF and rate -->
                        <label name="accounting_document_vat_label" class="fw-bold" for="accounting_document_vat_huf" invisible="account_move_action != 'update_fields' or accounting_move_type not in ['in_invoice', 'in_refund']" string="Document VAT"/>
                        <div name="accounting_document_vat_div" invisible="account_move_action != 'update_fields' or accounting_move_type not in ['in_invoice', 'in_refund']">
                            <field name="accounting_document_vat_huf"/>
                            <div class="d-flex d-flex-row gap-1" invisible="not accounting_document_rate_visible">
                                <field name="accounting_document_rate_visible" invisible="1"/>
                                <field name="accounting_document_rate_amount" class="w-auto"/>
                                <field name="company_currency_name" class="text-muted w-auto"/>
                                <span class="text-muted w-auto">/</span>
                                <field name="accounting_move_currency_name" class="text-muted w-auto"/>
                            </div>
                        </div>
                    </group>
                    <group name="accounting_fields_2">
                        <field name="accounting_date" invisible="account_move_action != 'update_fields' or accounting_move_type in ['out_invoice', 'out_refund']"/>
                        <field name="accounting_origin" invisible="account_move_action != 'update_fields'" string="Origin"/>
                        <field name="accounting_nav_payment_method" invisible="account_move_action != 'update_fields'" string="NAV Payment Method"/>
                    </group>
                </group>
                <!-- ACCOUNTING DELIVERY DATE -->
                <group name="accounting_delivery_date" class="border-top" colspan="2" invisible="action_type != 'account_move' or account_move_action != 'update_fields'">
                    <label name="accounting_delivery_date_label" class="mt-2" for="accounting_delivery_date" string="Delivery Date"/>
                    <div name="accounting_delivery_date_div" class="d-flex d-row gap-1 justify-content-start mt-2">
                        <field name="accounting_delivery_date" class="w-25" force_save="1" invisible="account_move_action != 'update_fields'" placeholder="Select..." readonly="accounting_delivery_period_enabled and accounting_move_type in ['out_invoice', 'out_refund']"/>
                        <span class="fw-bold w-auto">Period</span>
                        <field name="accounting_delivery_period_enabled" class="w-auto" widget="boolean_toggle"/>
                        <field name="accounting_delivery_period_start" class="text-end w-auto" invisible="not accounting_delivery_period_enabled" placeholder="Start date..."/>
                        <span class="w-auto" invisible="not accounting_delivery_period_enabled">-</span>
                        <field name="accounting_delivery_period_end" class="text-start w-auto" invisible="not accounting_delivery_period_enabled" placeholder="End date..."/>
                        <field name="accounting_delivery_period_legal" class="fw-light fst-italic text-start w-auto" invisible="not accounting_delivery_period_enabled"/>
                    </div>
                </group>
                <!-- ACCOUNTING VAT -->
                <group name="accounting_vat" class="border-top" colspan="2" invisible="action_type != 'account_move' or account_move_action != 'update_fields'">
                    <label name="accounting_vat_label" class="mt-2" for="accounting_vat_date" string="VAT Status"/>
                    <div name="accounting_vat_div" class="d-flex d-row gap-1 justify-content-start mt-2">
                        <field name="accounting_vat_status" class="w-25" invisible="account_move_action != 'update_fields'" placeholder="Select..."/>
                        <span class="fw-bold w-auto">VAT Date</span>
                        <field name="accounting_vat_date" class="w-25" invisible="account_move_action != 'update_fields'" placeholder="Select..."/>
                        <field name="accounting_cash_visible" invisible="1"/>
                        <span class="fw-bold w-auto" invisible="not accounting_cash_visible">Cash Accounting</span>
                        <field name="accounting_cash_enabled" class="w-auto" invisible="not accounting_cash_visible" widget="boolean_toggle"/>
                    </div>
                </group>
                <!-- HU+ OVERVIEW -->
                <group name="account_move_plus_overview" colspan="2" invisible="action_type != 'account_move' or account_move_action != 'check_status'">
                    <field name="account_move_plus_overview" colspan="2" nolabel="1"/>
                </group>
                <!-- TECHNICAL -->
                <group name="technical_data" invisible="action_type != 'technical' or technical_action != 'view_data'">
                    <div name="technical_data_display" colspan="2">
                        <field name="technical_data_display" style="word-break: break-word;" widget="code"/>
                    </div>
                </group>
                <!-- NOTEBOOK -->
                <notebook>
                    <page name="account_move" invisible="not account_move_visible" string="Account Move">
                        <group>
                            <field name="account_move_visible" invisible="1"/>
                            <field name="account_move" colspan="2" nolabel="1"/>
                        </group>
                    </page>
                    <page name="api_data" invisible="action_type != 'api' or api_action != 'view_api_data'" string="API Data">
                        <div name="api_data_display" colspan="2">
                            <field name="api_data_display" style="word-break: break-word;" widget="code"/>
                        </div>
                    </page>
                    <page name="partner" invisible="not partner_visible" string="Partner">
                        <group>
                            <field name="partner_visible" invisible="1"/>
                            <field name="partner" colspan="2" nolabel="1" widget="many2many_tags"/>
                        </group>
                    </page>
                </notebook>
                <!-- FOOTER -->
                <footer>
                    <field name="action_execute_visible" invisible="1"/>
                    <button name="action_execute" class="btn-primary" data-hotkey="s" default_focus="1" invisible="not action_execute_visible" string="Execute" type="object"/>
                    <button special="cancel" class="btn-default" data-hotkey="x" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
